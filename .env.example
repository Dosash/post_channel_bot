# ───────── Бот ─────────
# Токен бота от @BotFather. Бота можно сменить и в веб-панели («Настройки» → «Бот») —
# тогда этот токен остаётся запасным: с ним бот запустится, если токен из панели не примут.
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой: @Get_myidrobot). Первый — владелец.
# Если оставить пустым, владельцем станет первый, кто отправит боту /start.
ADMIN_IDS=

# Часовой пояс для отложенных постов, контент-плана и статистики
TIMEZONE=Europe/Moscow

# ───────── Веб-панель ─────────
# 127.0.0.1 — панель доступна только с этого компьютера/сервера (открывать через SSH-туннель или nginx);
# 0.0.0.0 — доступна из сети (только вместе с паролем!).
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Пароль входа в панель. Пусто — пароль задаётся в самой панели («Настройки»), а до этого панель открыта.
WEB_PASSWORD=

# Публичный адрес панели, если она открыта через домен (для ссылок из бота), например https://posts.example.com
WEB_PUBLIC_URL=

# Путь панели, если она открыта не в корне сайта (например, /posts → http://сервер/posts/). Пусто — в корне.
WEB_PREFIX=

# Ссылка «← Все панели» в меню панели (если у вас несколько панелей за одним nginx), например /. Пусто — без ссылки.
HUB_URL=

# 1 — панель стоит за nginx/прокси: доверять заголовку X-Forwarded-For (настоящий IP для защиты от перебора пароля)
TRUST_PROXY=0

# ───────── Хранение ─────────
DB_PATH=data/bot.db
UPLOADS_DIR=data/uploads
LOG_LEVEL=INFO
